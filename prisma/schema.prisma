generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Event {
  id        String    @id @default(cuid())
  title     String
  theme     String?
  date      DateTime
  venueName String
  venueArea String
  // Used by the day-before reminder email; all optional.
  mapsUrl           String? // Google Maps share link for the venue
  districtUrl       String? // venue page / booking link on District
  swiggyUrl         String? // venue page / booking link on Swiggy Dineout
  reminderOfferNote String? // the line shown above the table-booking buttons
  // Past-night recap shown on the public "Past nights" pages. Hidden until
  // recapPublished is switched on.
  // Tickets for this night are sold on another site (for example Sort My Scene).
  externalTicketUrl   String?
  externalTicketLabel String?
  recapPublished Boolean @default(false)
  winnerTeam     String?
  recapStats     String? // e.g. "20 teams · 73 quizzers"
  recapSummary   String?
  media          EventMedia[]
  invites        NightInvite[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
}

// A photo or clip for an event's recap. The file itself lives in Vercel Blob;
// pathname is kept so it can be deleted from there too.
model EventMedia {
  id             String   @id @default(cuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind           String // "image" | "video"
  role           String   @default("gallery") // "winners" | "gallery"
  url            String
  pathname       String
  posterUrl      String? // still frame shown before a video plays
  posterPathname String?
  caption        String?
  // Position among the night's photos (or clips), set by drag-to-reorder in the
  // admin. Rows that were never reordered are all 0 and fall back to upload time.
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([eventId])
}

model Booking {
  id          String   @id @default(cuid())
  teamName    String
  contactName String
  email       String
  phone       String?
  teamSize    Int      @default(1)
  message     String?
  status      String   @default("pending") // pending | confirmed | cancelled
  isRead      Boolean  @default(false)
  emailSent   Boolean  @default(false)
  // Snapshot of (status, teamSize) as of the last manually-sent update
  // email, so the admin panel knows whether the *current* values still
  // need a notification. statusEmailSentFor is null until the first send
  // (even a size-only update stamps it with the current status); a fresh
  // booking's teamSizeEmailSentFor starts equal to its initial teamSize
  // so the button doesn't activate until something actually changes.
  statusEmailSentFor   String?
  teamSizeEmailSentFor Int?
  // Day-before reminder + RSVP. rsvpToken is created lazily when the
  // reminder is first sent (it's the secret in the customer's RSVP link).
  // rsvpStatus is "coming" | "declined"; null means no reply yet.
  rsvpToken       String?   @unique
  rsvpStatus      String?
  rsvpHeadcount   Int?
  rsvpTableBooked Boolean?
  rsvpAt          DateTime?
  reminderSentAt  DateTime?
  nudgeSentAt     DateTime?
  attended        Boolean   @default(false)
  // Where the booking came from: "website" (our own signup form) or
  // "ticketing" (imported from the venue's ticketing app). Ticketing
  // attendees are individuals, not teams, and stay out of the public
  // "teams booked" number.
  source          String    @default("website")
  // When we asked them (by email) to book this night on the other ticketing site.
  externalAskedAt DateTime?
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId     String?
  createdAt   DateTime @default(now())
}

model VenueInquiry {
  id          String   @id @default(cuid())
  venueName   String
  contactName String
  email       String
  phone       String?
  message     String?
  status      String   @default("new") // new | contacted | closed
  isRead      Boolean  @default(false)
  emailSent   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// A round in the "How We Roll" format section on the homepage.
model QuizRound {
  id          String   @id @default(cuid())
  order       Int
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A partner venue tile in the "Where the Magic Happens" section on the homepage.
model Venue {
  id        String   @id @default(cuid())
  order     Int
  name      String
  area      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Someone who asked (via the link in an invite email) not to hear about new
// nights. Only invites check this; booking/reminder emails are separate.
model EmailOptOut {
  email     String   @id // lower-cased
  createdAt DateTime @default(now())
}

// One row per "new night" invite email actually sent, so nobody gets the same
// invite twice.
model NightInvite {
  id      String   @id @default(cuid())
  eventId String
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  email   String // lower-cased
  sentAt  DateTime @default(now())

  @@unique([eventId, email])
}

// ---------------------------------------------------------------------------
// Live quiz: questions built on the site, run on the projector, buzzed on phones.
// ---------------------------------------------------------------------------

model LiveQuiz {
  id             String        @id @default(cuid())
  title          String
  tiebreakPrompt String?
  tiebreakAnswer String? // a number (for example a year): the closest guess wins
  createdAt      DateTime      @default(now())
  rounds         LiveRound[]
  sessions       LiveSession[]
}

model LiveRound {
  id           String         @id @default(cuid())
  quizId       String
  quiz         LiveQuiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order        Int
  name         String
  blurb        String         @default("")
  rightPoints  Int
  wrongPenalty Int            @default(0) // points lost for a wrong answer or a skip; 0 means no negatives
  placeDecay   Boolean        @default(false) // later places score less (only used when there is no penalty)
  questions    LiveQuestion[]

  @@unique([quizId, order])
}

model LiveQuestion {
  id       String    @id @default(cuid())
  roundId  String
  round    LiveRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  order    Int
  kind     String    @default("text") // text | emoji | audio
  prompt   String
  hint     String?
  answer   String
  note     String?
  audioUrl String?

  @@unique([roundId, order])
}

// One run of a quiz night.
model LiveSession {
  id               String           @id @default(cuid())
  quizId           String
  quiz             LiveQuiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  code             String           @unique
  phase            String           @default("lobby") // lobby | roundIntro | question | reveal | celebrate | roundResults | tiebreak | tiebreakReveal | winners
  roundIdx         Int              @default(0)
  pos              Int              @default(0)
  version          Int              @default(0) // goes up on every change, so screens only fetch when something happened
  questionOpenedAt DateTime?
  phaseUntil       DateTime? // when a timed phase (the celebration, the answer) moves on by itself
  hideFromRound    Int              @default(4) // results from this round number onwards stay hidden until the winners slide
  lastTeamId       String? // the team shown in the celebration
  lastPoints       Int?
  tiedTeamIds      String? // comma separated, for the tie-breaker
  status           String           @default("active") // active | finished
  createdAt        DateTime         @default(now())
  teams            LiveTeam[]
  buzzes           LiveBuzz[]
  events           LiveScoreEvent[]
  guesses          LiveGuess[]
}

model LiveTeam {
  id        String      @id @default(cuid())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String
  tokenHash String // the one phone that holds this team's buzzer
  joinedAt  DateTime    @default(now())

  @@unique([sessionId, name])
  @@unique([sessionId, tokenHash])
}

model LiveBuzz {
  id         Int         @id @default(autoincrement())
  sessionId  String
  session    LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId String
  teamId     String
  buzzedAt   DateTime    @default(now())
  outcome    String      @default("pending") // pending | correct | wrong | skipped

  @@unique([sessionId, questionId, teamId]) // one team, one buzz per question
  @@index([sessionId, questionId])
}

// Every change to a team's score. The leaderboard is the sum of these.
model LiveScoreEvent {
  id         Int         @id @default(autoincrement())
  sessionId  String
  session    LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teamId     String
  questionId String?
  roundIdx   Int
  buzzId     Int?
  points     Int
  kind       String // correct | wrong | skipped | tiebreak
  createdAt  DateTime    @default(now())
  undoneAt   DateTime?

  @@index([sessionId])
}

model LiveGuess {
  id        String      @id @default(cuid())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teamId    String
  value     Int
  createdAt DateTime    @default(now())

  @@unique([sessionId, teamId])
}
